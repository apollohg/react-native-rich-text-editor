{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "typeRoots": ["./node_modules/@types"],
        "paths": {
            "@apollohg/react-native-rich-text-editor": ["../src/index.ts"],
            "@react-native-vector-icons/material-design-icons": ["./node_modules/@react-native-vector-icons/material-design-icons"],
            "expo-modules-core": ["./node_modules/expo-modules-core"],
            "react-native": ["./node_modules/react-native"]
        }
    },
    "include": ["./**/*.ts", "./**/*.tsx"],
    "exclude": ["./node_modules", "./android", "./ios"]
}
