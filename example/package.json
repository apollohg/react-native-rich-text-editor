{
  "name": "native-editor-example",
  "version": "2.0.5",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild --clean --no-install",
    "prebuild:android": "expo prebuild --clean --platform android --no-install",
    "prebuild:ios": "expo prebuild --clean --platform ios --no-install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollohg/react-native-rich-text-editor": "file:..",
    "@apollohg/react-native-rich-text-editor-code-highlighting": "file:../packages/code-highlighting",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^58.0.0-preview.6",
    "expo-font": "~58.0.2",
    "expo-image-manipulator": "~58.0.7",
    "expo-image-picker": "~58.0.6",
    "expo-status-bar": "~58.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-safe-area-context": "~5.9.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  }
