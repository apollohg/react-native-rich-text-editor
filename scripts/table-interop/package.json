{
    "name": "table-interop",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc -p tsconfig.json && tsc -p browser/tsconfig.json",
        "test:unit": "tsx --test cases/*.test.ts",
        "test:plumbing": "tsx run.ts --suite plumbing",
        "test:awareness": "tsx run.ts --suite awareness",
        "test:schema-admission": "tsx run.ts --suite schema-admission",
        "test:convergence": "tsx run.ts --suite convergence",
        "test:native-structural-edits": "tsx run.ts --suite native-structural-edits",
        "test:differential": "tsx run.ts --suite differential",
        "test:upstream-mutex": "tsx run.ts --suite upstream-mutex-repair-write-back",
        "reduce": "tsx reduce.ts"
    },
    "dependencies": {
        "@tiptap/core": "3.31.3",
        "@tiptap/extension-collaboration": "3.31.3",
        "@tiptap/extension-document": "3.31.3",
        "@tiptap/extension-paragraph": "3.31.3",
        "@tiptap/extension-table": "3.31.3",
        "@tiptap/extension-text": "3.31.3",
        "playwright": "1.63.0",
        "prosemirror-commands": "1.7.2",
        "prosemirror-model": "1.25.11",
        "prosemirror-schema-basic": "1.2.4",
        "prosemirror-state": "1.4.4",
        "prosemirror-tables": "1.8.5",
        "prosemirror-transform": "1.12.1",
        "prosemirror-view": "1.42.3",
        "y-prosemirror": "1.3.7",
        "y-protocols": "1.0.7",
        "yjs": "13.6.32"
    },
    "devDependencies": {
        "@types/node": "24.13.4",
        "esbuild": "0.28.2",
        "tsx": "4.23.13",
        "typescript": "5.9.3"
    }
}
