+    pub fn resolved_deletions(
+        &self,
+        txn: &mut TransactionMut,
+        item: &StackItem<M>,
+    ) -> Option<Vec<ResolvedDeletion>> {
+        if item.doc != txn.doc().guid() {
+            return None;
+        }
+        Self::deletion_candidates(&item.insertions, txn, &self.state.scope).map(|items| {
+            items.into_iter().map(|(source, source_len, target)| ResolvedDeletion {
+                source, source_len, target: *target.id(), target_len: target.len(),
+            }).collect()
+        })
+    }
