 impl Branch {
+    pub fn visit_text_range_deletion_scope<F: FnMut(ClientID, u32)>(
+        &self,
+        offset_kind: OffsetKind,
+        index: u32,
+        len: u32,
+        visit: &mut F,
+    ) -> usize {
+        let end = index.saturating_add(len);
+        let mut position = 0u32;
+        let mut walked = 0usize;
+        let mut pending = Vec::new();
+        let mut next = self.start;
+        while let Some(item) = next {
+            walked += 1;
+            next = item.right;
+            if item.is_deleted() {
+                continue;
+            }
+            if !item.is_countable() {
+                if position >= index {
+                    pending.push(item);
+                }
+            } else if position >= end {
+                if matches!(item.content, ItemContent::String(_) | ItemContent::Embed(_)) {
+                    break;
+                }
+            } else {
+                let item_end = position.saturating_add(item.content_len(offset_kind));
+                if item_end > index {
+                    pending.push(item);
+                }
+                position = item_end;
+            }
+        }
+        walked + Self::visit_deletion_subtrees(pending, visit)
+    }
