+}
+
+#[cfg(feature = "history-audit")]
+#[derive(Debug)]
+pub struct HistoryAuditIdentity(Arc<()>);
+
+#[cfg(feature = "history-audit")]
+impl PartialEq for HistoryAuditIdentity {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+
+#[cfg(feature = "history-audit")]
